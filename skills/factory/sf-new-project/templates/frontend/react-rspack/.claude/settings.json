{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Bash(gh pr merge:*)"],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/.husky/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.dependency-cruiser.cjs)",
      "Edit(/biome.json)",
      "Edit(/biome-plugins/**)",
      "Edit(/rstest.config.ts)",
      "Edit(/CONSTRAINTS.md)",
      "Edit(/AGENTS.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-load-bearing.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
