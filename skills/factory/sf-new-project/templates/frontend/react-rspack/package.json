{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "rspack dev",
    "build": "rspack build",
    "preview": "rspack preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm depcruise && rstest --changed --passWithNoTests",
    "check:deep": "pnpm check && pnpm build && pnpm audit --audit-level high",
    "prepare": "husky"
  },
